{
  "name": "online-check-in-prototype-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Virgin Australia online check-in prototype using React, TypeScript, pnpm workspaces and VDS design-system packages.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @va/check-in dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @va/check-in build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "jsdom": "latest",
    "sass": "latest"
  },
  "engines": {
    "node": ">=20.19"
  }
}